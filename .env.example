# ── ew-account-service-api environment ────────────────────────────────────────
# Copy to .env for development (the dev container does it on first open).
# Production values come from the ECS task definition (deploy/config.env);
# secrets from AWS Secrets Manager.

# ── Server ───────────────────────────────────────────────────────────────────
# Internal-only component: container port 8080 (Developers Guide: Ports and exposure).
# Dev host port is set in docker-compose.dev.yml: host port 3060 -> container 8080.
# Other dev containers on the ew-dev network reach it at http://account-service-api:8080
PORT=8080
NODE_ENV=development
# LOG_LEVEL=debug          # default: debug in development, info in production
# LOG_FORMAT=pretty        # default: pretty in development, json in production
# SHUTDOWN_TIMEOUT_MS=15000

# ── Callers ──────────────────────────────────────────────────────────────────
# Key callers (ew-portal-api) send in X-Api-Key (secret). Any long random string in dev,
# e.g. `openssl rand -hex 32`
ACCOUNT_SERVICE_API_KEY=change-me

# ── Aurora (SELECT only) ─────────────────────────────────────────────────────
# ew_index: account_index, user_index, license_index, institute_index, avatar_index
# grid DB:  useraccounts
AURORA_HOST=db.eurekaworld.internal
AURORA_PORT=3306
# Dev: the shared dev user for now. Production: account_service_api (db/setup.sql)
AURORA_USER=devopensim
AURORA_PASSWORD=change-me
# ew_index database (dev schemas carry the dev_ prefix)
INDEX_DB_NAME=dev_ew_index
# OpenSim grid database (useraccounts) of the dev grid
GRID_DB_NAME=change-me
# Query / connect timeout in ms
# DB_TIMEOUT_MS=3000

# ── Robust (grid account creation) ───────────────────────────────────────────
ROBUST_BASE_URL=http://172.31.37.82:8003
# ROBUST_TIMEOUT_MS=20000
# true = don't call Robust: a random UUID stands in for the grid PrincipalID and
# bms-adapter is still called. Dev/testing only; refused when NODE_ENV=production.
ROBUST_SKIP=false

# ── bms-adapter (BMS user + ew_index account_index/user_index) ───────────────
# Needs bms-adapter v39.8+ (POST /users returns accountId)
BMS_ADAPTER_BASE_URL=http://bmsadapter.eurekaworld.internal:8080
# bms-adapter's shared X-Api-Key for this environment (secret)
BMS_ADAPTER_API_KEY=change-me
# BMS_ADAPTER_TIMEOUT_MS=10000
