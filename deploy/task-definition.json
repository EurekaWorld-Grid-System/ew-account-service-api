{
  "family": "__APP__",
  "networkMode": "awsvpc",
  "requiresCompatibilities": ["FARGATE"],
  "cpu": "__CPU__",
  "memory": "__MEMORY__",
  "runtimePlatform": { "cpuArchitecture": "X86_64", "operatingSystemFamily": "LINUX" },
  "executionRoleArn": "__EXEC_ROLE_ARN__",
  "containerDefinitions": [
    {
      "name": "__APP__",
      "image": "__IMAGE__",
      "essential": true,
      "portMappings": [{ "containerPort": __PORT__, "protocol": "tcp" }],
      "stopTimeout": 20,
      "environment": [
        { "name": "NODE_ENV", "value": "production" },
        { "name": "PORT", "value": "__PORT__" },
        { "name": "LOG_LEVEL", "value": "info" },
        { "name": "LOG_FORMAT", "value": "json" }
      ],
      "healthCheck": {
        "command": [
          "CMD-SHELL",
          "node -e \"require('http').get('http://localhost:__PORT__/health', r => process.exit(r.statusCode === 200 ? 0 : 1)).on('error', () => process.exit(1))\""
        ],
        "interval": 30,
        "timeout": 5,
        "retries": 3,
        "startPeriod": 30
      },
      "logConfiguration": {
        "logDriver": "awslogs",
        "options": {
          "awslogs-group": "__LOG_GROUP__",
          "awslogs-region": "__R__",
          "awslogs-stream-prefix": "ecs"
        }
      }
    }
  ]
}
