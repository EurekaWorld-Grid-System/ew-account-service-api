# ── Deployment configuration: ew-account-service-api ───────────────────────────
# Sourced by deploy.sh and the one-time setup in deploy/README.md.
# IDs and config only — NO SECRETS in this file.
#
# SET_DURING_SETUP values are filled in by hand during the one-time infrastructure
# setup (deploy/README.md). deploy.sh refuses to run while any is left.

# ── AWS account / region ─────────────────────────────────────────────────────
R=eu-west-1
ACCT=157278781972
CLUSTER=default

# ── This component ───────────────────────────────────────────────────────────
# Name of the ECR repo, ECS service, task family, container and log group
APP=ew-account-service-api
# Internal hostname (private zone eurekaworld.internal → internal ALB, host-header rule).
# Temporary name during the migration out of ew-portal-api; the apiaccount CNAME moves here
# once every account function is migrated (Account Service Design v1.0 §1).
# Internal-only: no public hostname, no public ALB rule.
HOST=apiaccounttemp.eurekaworld.internal
# Container port (internal-only component: 8080, non-root)
PORT=8080
CPU=256
MEMORY=512
# Security group $APP-ecs (inbound 8080 from the internal ALB only) — printed by setup step 5
SG=sg-0429da6f90c29ac27
# Target group $APP-tg ARN — printed by setup step 7
TG=arn:aws:elasticloadbalancing:eu-west-1:157278781972:targetgroup/ew-account-service-api-tg/48ef3903894ff71e
# Priority on the internal ALB's 8080 listener (10 = apiaccount/apiportal, 20 = apigridengine,
# 30 = apigridservice, 40 = apiaccounttemp)
LISTENER_RULE_PRIORITY=40

# ── Shared infrastructure ────────────────────────────────────────────────────
VPC=vpc-0631d763
SUBNETS=subnet-ace6d5ea,subnet-3616e053,subnet-84ddcff0
# Internal ALB (owned by the ew-portal-api workstream; Asaff adds rules/SG entries)
INTERNAL_ALB_SG=sg-073781d3968e98472
INTERNAL_ALB_DNS=internal-ew-internal-alb-664812254.eu-west-1.elb.amazonaws.com
# The internal ALB's HTTP 8080 listener (ew-internal-alb) — from setup step 0
INTERNAL_L8080=arn:aws:elasticloadbalancing:eu-west-1:157278781972:listener/app/ew-internal-alb/9fb3667e741164d2/2fb72efd7d42a590
# Route 53 private hosted zone eurekaworld.internal — from setup step 0
INTERNAL_ZONE=Z3IYJHI6FZVIDY

# ── Derived ──────────────────────────────────────────────────────────────────
REGISTRY=$ACCT.dkr.ecr.$R.amazonaws.com
ECR=$REGISTRY/$APP
EXEC_ROLE_ARN=arn:aws:iam::$ACCT:role/$APP-exec
LOG_GROUP=/ecs/$APP
